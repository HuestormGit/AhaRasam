# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Strapi backend ----
REACT_APP_STRAPI_URL=http://localhost:1337

# NOTE: there is no Strapi API token here, and none may be added. Everything
# prefixed REACT_APP_ is inlined verbatim into the public JS bundle, so a token
# put here is published to every visitor — a "read only" or "custom" token just
# publishes a smaller key. This app needs no such token:
#
#   * Catalogue and cart (products, product variants, /checkout/quote,
#     /checkout/shipping-options) are granted to Strapi's PUBLIC role and are
#     called with no Authorization header at all.
#   * Customer-specific calls (/api/users/me, /api/orders/razorpay/create,
#     /api/orders/razorpay/verify) send the logged-in customer's own JWT via
#     customerRequest() in src/utils/Api.js.
#
# Anything that still seems to need a private credential in React belongs
# behind a Strapi route instead.

# ---- Razorpay (TEST mode only) ----
# Publishable key id — safe to ship in the browser bundle.
# Must start with rzp_test_ for test mode.
# REACT_APP_RAZORPAY_KEY=your_test_key_here

# NOTE: the Razorpay KEY SECRET must NEVER live in this React app, not even
# commented out. Anything prefixed REACT_APP_ is inlined into the public JS
# bundle. The key id and secret belong only on the Strapi backend, which signs
# orders and verifies signatures for /api/orders/razorpay/create and /verify.
# Set them in Strapi-Code/.env, never here.
