# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Strapi backend ----
REACT_APP_STRAPI_URL=https://your-strapi-host.example.com/
REACT_APP_STRAPI_TOKEN=your_strapi_api_token_here

# ---- Razorpay (TEST mode only) ----
# Publishable key id — safe to ship in the browser bundle.
# Must start with rzp_test_ for test mode.
# REACT_APP_RAZORPAY_KEY=your_test_key_here

# NOTE: the Razorpay KEY SECRET must NEVER live in this React app.
# Anything prefixed REACT_APP_ is inlined into the public JS bundle.
# The secret belongs only on the Strapi backend, which signs and
# verifies payments via /api/orders/razorpay/create and /verify:
# RAZORPAY_KEY_ID=your_test_key_here
# RAZORPAY_KEY_SECRET=your_test_secret_here
